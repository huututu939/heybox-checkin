<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HeyboxCheckin" parent="@android:style/Theme.Material.Light.NoActionBar">
        <!-- 与 LightPalette.canvas 对齐，避免 Compose 起来前闪一帧别的底色。 -->
        <item name="android:windowBackground">#FFF5F1E8</item>
        <!-- 透明系统栏：让光斑背景铺到状态栏和手势条后面，才叫沉浸式。 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- 系统栏图标明暗与对比度由 MainActivity 的 enableEdgeToEdge() 在运行时设置，
             API 29+ 才有的属性不写在 XML 里，免得 minSdk 26 触发 NewApi。 -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
